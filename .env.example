# Copy this file to ".env" and fill in your real keys. Never commit ".env" itself.

# Get these free from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=REPLACE_WITH_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=REPLACE_WITH_YOUR_PAYSTACK_SECRET_KEY

# Port the server runs on (Render/Railway will set this automatically)
PORT=3000

# --- VTpass (sign up at https://vtpass.com, or use sandbox.vtpass.com to test free) ---
# Leave blank for now — orders will just be logged for manual fulfillment
# Sandbox base URL: https://sandbox.vtpass.com/api
# Live base URL:    https://vtpass.com/api
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=REPLACE_WITH_YOUR_VTPASS_API_KEY
VTPASS_SECRET_KEY=REPLACE_WITH_YOUR_VTPASS_SECRET_KEY
VTPASS_EMAIL=sandbox@vtpass.com

# --- Auth ---
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# --- Email (for password reset links) ---
# Create a dedicated Gmail account for this, then generate an "App Password"
# at https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be turned on for that Gmail account first). Never use your normal Gmail password here.
SMTP_EMAIL=REPLACE_WITH_YOUR_SENDING_GMAIL_ADDRESS
SMTP_APP_PASSWORD=REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD
